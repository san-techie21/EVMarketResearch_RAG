# Self-host stack configuration. Copy to infra/.env and fill in.

# -- Postgres (pgvector container) ------------------------------------------
POSTGRES_USER=evrag
POSTGRES_PASSWORD=evrag_dev_pw
POSTGRES_DB=ev_research
# Host port -> container 5432. If you already run Postgres locally (5432/5433),
# pick a free port like 55432 to avoid a silent collision.
DB_PORT=55432

# -- Ports ------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000

# ===========================================================================
# THE ONE THING YOU MUST SET: your LLM key.  Pick ONE of the options below.
# (Embeddings run locally and need no key.)
# ===========================================================================

# Option A - Anthropic (Claude):
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-api03-...
# LLM_MODEL=claude-sonnet-4-6        # optional override

# Option B - OpenAI: (comment out Option A, uncomment these)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option C - any OpenAI-compatible API (DeepSeek, Groq, Together, ...):
# LLM_PROVIDER=openai
# LLM_API_KEY=...
# LLM_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com

# Sign-in token signing secret (any long random string):
JWT_SECRET=change-me-to-a-long-random-string

# -- Retrieval tuning -------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HYBRID_CANDIDATES=40
RAG_TOP_K=10
USE_RERANKER=1

# -- Optional: live EV station data (free) ----------------------------------
OPENCHARGEMAP_API_KEY=
NREL_API_KEY=DEMO_KEY
